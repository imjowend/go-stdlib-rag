# Copiá este archivo a .env y completá con tus credenciales reales.
# El archivo .env está en .gitignore y NO se versiona.

# --- Embeddings ---
# Si usas Jina: API key del free tier: https://jina.ai/embeddings/
EMBEDDER_API_KEY=your-embeddings-api-key-here

# --- Vector DB ---
# Por ejemplo, para Qdrant Cloud (ej: https://xxxx-xxxx.aws.cloud.qdrant.io:6333)
VECTOR_STORE_URL=https://your-cluster-endpoint.cloud.qdrant.io:6333
# API key del cluster de la DB Vectorial
VECTOR_STORE_API_KEY=your-vector-db-api-key-here

# --- Gemini API (LLM) ---
GEMINI_API_KEY=your-gemini-api-key-here