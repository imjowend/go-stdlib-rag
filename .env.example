# Copiá este archivo a .env y completá con tus credenciales reales.
# El archivo .env está en .gitignore y NO se versiona.

# --- Jina AI (embeddings) ---
# API key del free tier: https://jina.ai/embeddings/
JINA_API_KEY=your-jina-api-key-here

# --- Qdrant Cloud (vector DB) ---
# URL del cluster (ej: https://xxxx-xxxx.aws.cloud.qdrant.io:6333)
QDRANT_URL=https://your-cluster-endpoint.cloud.qdrant.io:6333
# API key del cluster de Qdrant Cloud
QDRANT_API_KEY=your-qdrant-api-key-here
